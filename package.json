{
  "name": "dsh-fish-memory-pro",
  "version": "1.4.0",
  "description": "给 DSH 里的会话一份会淡忘的长期记忆，每条都带时间。（改动版：加了「主动遗忘」）",
  "license": "MIT",
  "type": "module",
  "author": "CODES233",
  "contributors": [
    "Yuuyuko-uu (https://github.com/Yuuyuko-uu/dsh-fish-memory)"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "ai-companion",
    "active-forgetting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CODES233/dsh-jibao-plugins.git",
    "directory": "packages/dsh-fish-memory-pro"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
